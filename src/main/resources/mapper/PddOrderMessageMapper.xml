<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.main.mapper.PddOrderMessageMapper">

    <resultMap id="BaseResultMap" type="com.order.main.entity.PddOrderMessage">
        <id column="id" property="id"/>
        <result column="msg_type" property="msgType"/>
        <result column="mall_id" property="mallId"/>
        <result column="shop_id" property="shopId"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="retry_count" property="retryCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, msg_type, mall_id, shop_id, content, status, retry_count, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.order.main.entity.PddOrderMessage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pdd_order_message (msg_type, mall_id, shop_id, content, status, retry_count)
        VALUES (#{msgType}, #{mallId}, #{shopId}, #{content}, #{status}, #{retryCount})
    </insert>

    <select id="selectPending" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pdd_order_message
        WHERE status IN (0, 3)
        ORDER BY create_time ASC
        LIMIT #{limit}
    </select>

    <update id="updateStatus" parameterType="com.order.main.entity.PddOrderMessage">
        UPDATE pdd_order_message
        SET status = #{status},
            retry_count = #{retryCount}
        WHERE id = #{id}
    </update>

</mapper>
