<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.main.mapper.OrderCompanyRetryMapper">

    <resultMap id="BaseResultMap" type="com.order.main.entity.OrderCompanyRetry">
        <id property="id" column="id"/>
        <result property="shopId" column="shop_id"/>
        <result property="erpOrderId" column="erp_order_id"/>
        <result property="orderSn" column="order_sn"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="companyName" column="company_name"/>
        <result property="retryCount" column="retry_count"/>
        <result property="status" column="status"/>
        <result property="lastResult" column="last_result"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, shop_id, erp_order_id, order_sn, tracking_number, company_name,
        retry_count, status, last_result, create_time, update_time
    </sql>

    <!-- 新增 -->
    <insert id="insert" parameterType="com.order.main.entity.OrderCompanyRetry" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_company_retry (
            shop_id, erp_order_id, order_sn, tracking_number, company_name,
            retry_count, status, last_result
        ) VALUES (
            #{shopId}, #{erpOrderId}, #{orderSn}, #{trackingNumber}, #{companyName},
            #{retryCount}, #{status}, #{lastResult}
        )
    </insert>

    <!-- 查询待重试记录 -->
    <select id="selectPendingList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM order_company_retry
        WHERE status = 0
        ORDER BY create_time ASC
    </select>

    <!-- 根据主键查询 -->
    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM order_company_retry
        WHERE id = #{id}
    </select>

    <!-- 更新重试结果 -->
    <update id="updateRetryResult" parameterType="com.order.main.entity.OrderCompanyRetry">
        UPDATE order_company_retry
        SET retry_count = #{retryCount},
            status = #{status},
            last_result = #{lastResult}
        WHERE id = #{id}
    </update>

</mapper>
